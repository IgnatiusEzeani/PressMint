      <div type="article" xml:id="PressMint-GB_1893-01-21_WidnesExaminer_art0083" n="art0083">
        <head>ACOBS 0</head>
        <p>ACOBS 0</p>
        <p>MATRIMONIAL INFELICITY AT WARMNUTON.</p>
