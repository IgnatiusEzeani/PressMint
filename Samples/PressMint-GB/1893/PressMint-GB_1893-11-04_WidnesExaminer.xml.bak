      <div type="article" xml:id="PressMint-GB_1893-11-04_WidnesExaminer_art0090" n="art0090">
        <head>CONSUMED IN GREAT BRITAIN IS SOLD BY</head>
        <p>CONSUMED IN GREAT BRITAIN IS SOLD BY</p>
