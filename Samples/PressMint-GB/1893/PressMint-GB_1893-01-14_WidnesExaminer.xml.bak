      <div type="article" xml:id="PressMint-GB_1893-01-14_WidnesExaminer_art0046" n="art0046">
        <head>The</head>
        <p>The</p>
        <p>MAKERS</p>
        <p>TUE SHIP CANAL</p>
        <p>FROM ACTON GRANGE TO THELWALL.</p>
