      <div type="article" xml:id="PressMint-GB_1916-02-05_WidnesExaminer_art0175" n="art0175">
        <head>FOCITBALL FIELD.</head>
        <p>THE FOCITBALL FIELD.</p>
        <p>SECOND WAR-YEAR SEAS,</p>
        <p>•:. .) •:........:-:••:,•:..:-.:.•.:.•:•,:-:-:...,:-:-:•.).:,....)-7,..,</p>
