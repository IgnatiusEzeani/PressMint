      <div type="article" xml:id="PressMint-GB_1916-11-11_WidnesExaminer_art0087" n="art0087">
        <head>Miss L. Speakman (Lynim)</head>
        <p>Miss L. Speakman (Lynim)</p>
        <p>Mr. G. James</p>
        <p>0 5 0</p>
