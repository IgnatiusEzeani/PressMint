      <div type="article" xml:id="PressMint-GB_1914-04-11_WidnesExaminer_art0225" n="art0225">
        <p>THE EXAMINER, SAT UIIDA Y. APRIL 11, 1914</p>
        <p>&lt;4.111;:e</p>
        <p>_</p>
        <p>WARRINGTON harCh</p>
        <p>C</p>
        <p>r 1 1 •</p>
        <p>\ ) Jr:3‘k</p>
