      <div type="article" xml:id="PressMint-GB_1914-07-11_WidnesExaminer_art0086" n="art0086">
        <head>TRAVELLERS' CLASSES, Need for Specialisation in Form</head>
        <p>TRAVELLERS' CLASSES, Need for Specialisation in Form</p>
