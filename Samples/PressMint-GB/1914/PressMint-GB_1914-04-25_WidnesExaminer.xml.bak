      <div type="article" xml:id="PressMint-GB_1914-04-25_WidnesExaminer_art0202" n="art0202">
        <head>ARMY 61( PEOPLE,</head>
        <p>ARMY 61( PEOPLE,</p>
        <p>Lord Newton Calls for a Geul Election.</p>
      </div>
      <div type="article" xml:id="PressMint-GB_1914-04-25_WidnesExaminer_art0203" n="art0203">
        <head>CHALLENG.S TO LIBER,</head>
        <p>CHALLENG.S TO LIBER,</p>
