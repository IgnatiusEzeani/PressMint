      <div type="article" xml:id="PressMint-GB_1914-04-25_WidnesExaminer_art0002" n="art0002">
        <p>J. POVEY &amp; SON,</p>
        <p>BRIDGE STREET, WARRINGTON.</p>
      </div>
      <div type="article" xml:id="PressMint-GB_1914-04-25_WidnesExaminer_art0003" n="art0003">
        <head>"THE EXAMINER" OFFICE.</head>
        <p>"THE EXAMINER" OFFICE.</p>
        <p>BEWSEY STREET.</p>
      </div>
      <div type="article" xml:id="PressMint-GB_1914-04-25_WidnesExaminer_art0004" n="art0004">
        <gap reason="ocrQuality" quantity="0" unit="words">
          <desc>skipped/gap: fewer than 20 non-control characters after cleanup</desc>
