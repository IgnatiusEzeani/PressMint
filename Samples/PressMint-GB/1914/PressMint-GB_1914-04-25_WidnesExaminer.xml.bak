      <div type="article" xml:id="PressMint-GB_1914-04-25_WidnesExaminer_art0114" n="art0114">
        <head>EXAMINER,</head>
        <p>THE EXAMINER,</p>
        <p>SATURDAY, APRIL 25, 1914.</p>
        <p>REACHING THE DREGS.</p>
        <p>1 1 T t -ii, j fi</p>
