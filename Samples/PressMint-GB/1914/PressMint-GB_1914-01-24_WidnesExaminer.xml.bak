      <div type="article" xml:id="PressMint-GB_1914-01-24_WidnesExaminer_art0256" n="art0256">
        <head>EXAMINER, SATURDAY, JANUARY 24, 1914.</head>
        <p>THE EXAMINER, SATURDAY, JANUARY 24, 1914.</p>
        <p>Money.</p>
