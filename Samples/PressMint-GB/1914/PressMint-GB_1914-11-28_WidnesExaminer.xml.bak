      <div type="article" xml:id="PressMint-GB_1914-11-28_WidnesExaminer_art0172" n="art0172">
        <head>WAVE YOU</head>
        <gap reason="ocrQuality" quantity="4" unit="words">
          <desc>skipped/gap: fewer than 20 non-control characters after cleanup</desc>
