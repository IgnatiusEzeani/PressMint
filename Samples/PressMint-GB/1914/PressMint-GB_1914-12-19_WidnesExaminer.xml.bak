      <div type="article" xml:id="PressMint-GB_1914-12-19_WidnesExaminer_art0168" n="art0168">
        <head>BEST HOUSE HAI</head>
        <p>BEST HOUSE HAI</p>
        <p>NUTS 81 SLACK, WAsHED</p>
        <p>UTS, BEANS 81 PEAS,</p>
        <p>CROMPTON &amp; SHAWCROSS LTD</p>
