      <div type="article" xml:id="PressMint-GB_1914-08-29_WidnesExaminer_art0149" n="art0149">
        <head>JOTTINGS BY AN OLD</head>
        <p>JOTTINGS BY AN OLD</p>
        <p>, JOURNALIST.</p>
        <p>t</p>
        <p>• ,t</p>
        <p>f . :, ': , ; qv,</p>
