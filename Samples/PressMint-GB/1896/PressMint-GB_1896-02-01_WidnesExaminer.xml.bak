      <div type="article" xml:id="PressMint-GB_1896-02-01_WidnesExaminer_art0005" n="art0005">
        <p>SATURDAY, FEBRUARY 1, 1896</p>
      </div>
      <div type="article" xml:id="PressMint-GB_1896-02-01_WidnesExaminer_art0006" n="art0006">
        <p>RoyaTi'S HERBAL EMBROCATION.</p>
      </div>
      <div type="article" xml:id="PressMint-GB_1896-02-01_WidnesExaminer_art0007" n="art0007">
