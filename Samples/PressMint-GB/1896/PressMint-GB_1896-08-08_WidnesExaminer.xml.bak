      <div type="article" xml:id="PressMint-GB_1896-08-08_WidnesExaminer_art0045" n="art0045">
        <head>UNDERTAKE</head>
        <p>UNDERTAKE</p>
        <p>PRINTING FOR ACCOUNTANTS,</p>
        <p>PRINTING FOR CRICKET CLUBS,</p>
        <p>PRINTING FOR BANKS,</p>
        <p>PRINTING FOR AUCTIONEERS,</p>
