      <div type="article" xml:id="PressMint-GB_1899-10-06_WidnesExaminer_art0031" n="art0031">
        <head>EXAMINER, FRIDAY, OCTOBER 6, 1899.</head>
        <p>THE EXAMINER, FRIDAY, OCTOBER 6, 1899.</p>
