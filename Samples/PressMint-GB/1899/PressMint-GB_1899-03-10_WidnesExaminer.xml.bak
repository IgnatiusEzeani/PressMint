      <div type="article" xml:id="PressMint-GB_1899-03-10_WidnesExaminer_art0014" n="art0014">
        <head>=it t. rip-7 4. S I $</head>
        <p>=it t. rip-7 4. S I $</p>
        <p>GRATEFUL-COM FORTING.</p>
        <p>pc c •</p>
        <p>BREAKFAST AND SUPPER,'</p>
