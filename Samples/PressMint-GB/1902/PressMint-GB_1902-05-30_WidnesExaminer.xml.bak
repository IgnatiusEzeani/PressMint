      <div type="article" xml:id="PressMint-GB_1902-05-30_WidnesExaminer_art0111" n="art0111">
        <head>CONCERTS</head>
        <p>CONCERTS</p>
        <p>SOIREES BALLS</p>
        <p>PROGRAMMES FOR FETES, PROGRAMMES FOR BAZARS. PROGRAMMES FO3 SALES OF WORE,</p>
        <p>PROGRAMMES FON SOIREES. PROGRAMMES FOR CONCERTS.</p>
        <p>JOHN WALKER AND CO.,</p>
