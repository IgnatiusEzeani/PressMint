      <div type="article" xml:id="PressMint-GB_1911-10-14_WidnesExaminer_art0056" n="art0056">
        <head>WORKS ASSOCIATION.</head>
        <p>WORKS ASSOCIATION.</p>
        <p>ANNUAL lIANDICAP.</p>
