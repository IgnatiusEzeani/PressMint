      <div type="article" xml:id="PressMint-GB_1906-12-22_WidnesExaminer_art0119" n="art0119">
        <head>RUNCORN AND WIDNES.</head>
        <p>RUNCORN AND WIDNES.</p>
        <p>ST HELENS.</p>
