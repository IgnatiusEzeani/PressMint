      <div type="article" xml:id="PressMint-GB_1906-06-09_WidnesExaminer_art0189" n="art0189">
        <head>WARRINGTON TOWN COUNCIL</head>
        <p>WARRINGTON TOWN COUNCIL</p>
        <p>18,000 PAID FOR SHIP CANAL</p>
        <p>ACTION.</p>
        <p>Big Sum Wanted for Property</p>
        <p>Purchasing.</p>
