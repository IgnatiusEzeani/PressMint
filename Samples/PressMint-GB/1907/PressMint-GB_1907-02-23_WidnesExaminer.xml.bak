      <div type="article" xml:id="PressMint-GB_1907-02-23_WidnesExaminer_art0080" n="art0080">
        <head>Mr. A. H. CROSFIELD M.P. ON THE WORK OF THE</head>
        <p>Mr. A. H. CROSFIELD M.P. ON THE WORK OF THE</p>
