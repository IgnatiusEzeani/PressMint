        </gap>
      </div>
      <div type="article" xml:id="PressMint-GB_1908-04-11_WidnesExaminer_art0111" n="art0111">
        <gap reason="ocrQuality" quantity="2" unit="words">
          <desc>skipped/gap: fewer than 20 non-control characters after cleanup</desc>
        </gap>
      </div>
      <div type="article" xml:id="PressMint-GB_1908-04-11_WidnesExaminer_art0112" n="art0112">
        <gap reason="ocrQuality" quantity="1" unit="words">
