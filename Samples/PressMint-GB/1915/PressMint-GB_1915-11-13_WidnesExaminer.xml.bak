      <div type="article" xml:id="PressMint-GB_1915-11-13_WidnesExaminer_art0229" n="art0229">
        <head>FENNINGS'</head>
        <p>FENNINGS'</p>
        <p>THE GREAT PREVENTIVE &amp; CURE OF FEVERS &amp; INFECTIOUS DISEASES.</p>
