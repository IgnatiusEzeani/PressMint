      <div type="article" xml:id="PressMint-GB_1915-04-24_WidnesExaminer_art0136" n="art0136">
        <head>INGTON*</head>
        <p>INGTON*</p>
        <p>(Regd. Trade Mark.)</p>
        <p>S_. ' r. .xl.ri • , e'A ,Ik and il</p>
