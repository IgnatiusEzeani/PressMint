      <div type="article" xml:id="PressMint-GB_1915-05-22_WidnesExaminer_art0177" n="art0177">
        <p>1 f '1 /.' 11 f‘ i i1 . ff • '</p>
      </div>
      <div type="article" xml:id="PressMint-GB_1915-05-22_WidnesExaminer_art0178" n="art0178">
        <gap reason="ocrQuality" quantity="1" unit="words">
          <desc>skipped/gap: fewer than 20 non-control characters after cleanup</desc>
