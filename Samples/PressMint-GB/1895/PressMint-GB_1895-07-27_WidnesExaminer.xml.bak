      <div type="article" xml:id="PressMint-GB_1895-07-27_WidnesExaminer_art0102" n="art0102">
        <head>EXAMIN.ER.</head>
        <p>THE EXAMIN.ER.</p>
        <p>SATURDAY, JULY 27, 1895.</p>
