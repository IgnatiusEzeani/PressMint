      <div type="article" xml:id="PressMint-GB_1900-12-07_WidnesExaminer_art0097" n="art0097">
        <head>COMBINATION.</head>
        <p>COMBINATION.</p>
        <p>RESULTS UP TO SATURDAY, DECEMBER_ 1.</p>
