      <div type="article" xml:id="PressMint-GB_1901-09-13_WidnesExaminer_art0112" n="art0112">
        <head>BENSON'S GOLD &amp; GEM JEWELLERY</head>
        <p>BENSON'S GOLD &amp; GEM JEWELLERY</p>
        <p>2e</p>
        <p>c,,_._____,-7--7-..,..„ ~...gflPt'w, ~,$..;.r.,-,,,</p>
        <p>Gold a Pearl Lace</p>
        <p>SENT ON</p>
