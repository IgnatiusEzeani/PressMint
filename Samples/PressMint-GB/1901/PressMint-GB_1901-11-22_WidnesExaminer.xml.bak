      <div type="article" xml:id="PressMint-GB_1901-11-22_WidnesExaminer_art0099" n="art0099">
        <head>MIIMMINIUMNIMIINIIMMMV –</head>
        <p>MIIMMINIUMNIMIINIIMMMV -</p>
