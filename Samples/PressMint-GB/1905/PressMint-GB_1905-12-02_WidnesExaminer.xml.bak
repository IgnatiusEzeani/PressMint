      <div type="article" xml:id="PressMint-GB_1905-12-02_WidnesExaminer_art0014" n="art0014">
        <head>WO.M_AN'S REALM. DRESS-FASII TO N-HOll E.</head>
        <p>WO.M_AN'S REALM. DRESS-FASII TO N-HOll E.</p>
        <p>PRINCESS NIC:IOLAS CT GREECE.</p>
      </div>
      <div type="article" xml:id="PressMint-GB_1905-12-02_WidnesExaminer_art0015" n="art0015">
