      <div type="article" xml:id="PressMint-GB_1913-08-09_WidnesExaminer_art0158" n="art0158">
        <head>JOTTINGS BY AN OLD</head>
        <p>JOTTINGS BY AN OLD</p>
        <p>JOURNALIST.</p>
