      <div type="article" xml:id="PressMint-GB_1913-12-13_WidnesExaminer_art0085" n="art0085">
        <head>4,. T. GILLIGAN,</head>
        <p>4,. T. GILLIGAN,</p>
        <p>Horsemarket Street,</p>
