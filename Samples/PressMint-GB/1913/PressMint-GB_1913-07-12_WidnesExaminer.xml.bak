        <p>Photograph by Ernest Brooks. THEIR MAJESTIES SPEAKING TO MISS MARSH. Left to Right: Miss Marsh, The King, Capt. Crosfield, The Queen, Mr. J. J. Crosfield.</p>
        <p>• . , t ' :.- ...,,,s"'-' . -P4l.T,tri .. ~ . . I -•.-- ....„,„., -.-. ' • it ' ~ • ' . pN • 0 , ' • s , . ." . . , . , • , , ~ • • , , e , , ,„, . , ' . • , s ~, ..... , e , • ~ • , • :: ', ~ . .0, - . , • , 7,tteif# • - '' .410.4.-".,*_''''.' -',':..i,•,;''''-: - , I s., - i-, v .. , :,,,, .0 .: . . . . . .. ~ --.- :.-,,,,..,‘. ~. - - • -, •,. ilr , . ',,' 1 , 4_ • „ . ,i• , Nii . . . . . , .4 .. . . , 0, „.,,„.:4 , . , . , . ~ . , .. .. ! -. , ......... ~.... . ' '''';' , , '''','... . ‘i, i..". \•—i,',,..' ', - • . - ' ' . 'S ' . ' s'''' . , ".' ,• ' ' ''' ' ''',.. ' - .. ,` ' .•.# 0 - - , ‘.^- c'. • 'tl' ' . ' . -* ' v - • ‘,. 'St -;'‘ , , • .. - &gt; . • . . , : ' • '''''''':', ' ..%:14,14;'''' .. . ' i', ',f ' 1' i '''';:i ' ' . * '' • ''' . '. . :,,:::::,,is '''''.' '''.,P,.!‘' " '' : . • ‘l',:4 # ,*,''' : A . ri ' ' . -,,,,... s-,.,:1,7 -, '' . ,:, ', i.:.z.;, ti I . i‘ . ~ • . ,1, 1. i l:i . .''' .z ~.;;'..-:,:;.;•.1 ' ~ " , __ •,' „ ,4'„ • ,', • .:,`,,'' ' ' . '' * ' ' • ',1,51 ‘,',", • • -,'' '' * :*: ' ' ','•'''''.:"' '''''') , '• ' '' . '4.".•`,,,,, ~,• • ' , ‘,.*?^;•:•',*""•,,''''',„' 1,,,,,,,•,,i,', ' V • 1 ;o• ,V,,i, ° ' : • . '''• '`.°,;&lt;::„‘' .•'•*s^",{.'6,.,M•fcl&gt;: 'lZ,‘`;'''l,'‘*' ~c ,°, i , ' ' ' ..,':::, •'•,:',:'•, '' , ' ' ' ::',lst'':•-:••**'`.• '4* .9 ''.• '''•:7;i'.'i'l;'.:'t''''''•:l*•4•l,‘,, '' •,' * ' 1 - ^,,*'''''''#'. ''''' •• , _ ••'' .•,17;*.,::‘ -* • • ' •: '' ''' --*,-°:•,:?•;';!7' '' '',"l'^''' , *,it,',,;:it-T-, ‘",•''' : * - ' ,',;'. '„ * '. , , 44, *. •‘ ' ''- 1,,,,,,,, , .-5? ~„,,,,,,,,-‘•,-5,5,,,,, , ''''... '' • f ^ '.,&lt;!'''':::`;','''.:,:',Ziltr'''''&amp;'''' I , ~ ,</p>
