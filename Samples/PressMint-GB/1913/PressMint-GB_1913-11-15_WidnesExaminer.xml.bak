      <div type="article" xml:id="PressMint-GB_1913-11-15_WidnesExaminer_art0123" n="art0123">
        <head>ATLANTIC W</head>
        <p>ATLANTIC W</p>
        <p>PADDOCK,I 14CODERS</p>
