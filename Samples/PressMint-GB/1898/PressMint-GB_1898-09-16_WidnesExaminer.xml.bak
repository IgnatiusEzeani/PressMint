      <div type="article" xml:id="PressMint-GB_1898-09-16_WidnesExaminer_art0067" n="art0067">
        <p>, r . rf, ~ ~.. ~ ~...T.: , LN :, ; . ;</p>
      </div>
      <div type="article" xml:id="PressMint-GB_1898-09-16_WidnesExaminer_art0068" n="art0068">
        <gap reason="ocrQuality" quantity="2" unit="words">
