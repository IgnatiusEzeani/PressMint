      <div type="article" xml:id="PressMint-GB_1909-12-24_WidnesExaminer_art0050" n="art0050">
        <head>ASSOCIATION FOOTBALL.</head>
        <p>ASSOCIATION FOOTBALL.</p>
        <p>THE LEAGUE.—FIRST DIVISION. Goals—</p>
