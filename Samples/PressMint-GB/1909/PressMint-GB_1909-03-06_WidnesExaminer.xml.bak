      <div type="article" xml:id="PressMint-GB_1909-03-06_WidnesExaminer_art0150" n="art0150">
        <head>//ARHUS</head>
        <p>//ARHUS</p>
        <p>ORA CHA: pit"</p>
        <p>, Ce"PetTti</p>
